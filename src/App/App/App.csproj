<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <InvariantGlobalization>true</InvariantGlobalization>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <Content Include=".dockerignore" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.101.4" />
      <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
      <PackageReference Include="AWSSDK.SQS" Version="4.0.100.14" />
      <PackageReference Include="CliWrap" Version="3.10.5" />
      <PackageReference Include="FFMpegCore" Version="5.5.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="alphazero.imageprocessing" Version="1.0.1" />
    </ItemGroup>

</Project>
